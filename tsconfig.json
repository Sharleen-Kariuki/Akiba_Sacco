{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "files": [
    "src/app.ts",
    "src/dictionary.ts",
    "src/fsm.ts",
    "src/keypad.ts",
    "src/logger.ts",
    "src/menus.ts",
    "src/phone.ts",
    "src/timeout.ts",
    "src/types.ts"
  ]
}
